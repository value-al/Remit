{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Funding": "Host=localhost;Port=5432;Database=remit;Username=remit;Password=remit"
  },
  "RabbitMq": {
    "Uri": "amqp://guest:guest@localhost:5672",
    "Exchange": "remit"
  },
  "OutboxRelay": {
    "PollInterval": "00:00:00.500",
    "BatchSize": 50
  },
  "Psp": {
    "Providers": {
      "alpha": { "Currencies": [ "EUR", "USD", "GBP" ], "WebhookSecret": "whsec_alpha_dev", "Behaviour": "accept" },
      "beta": { "Currencies": [ "EUR", "GBP" ], "WebhookSecret": "whsec_beta_dev", "Behaviour": "accept" }
    }
  }
}
